# Copy to .env.local for local development. Never commit real values.

# Vercel Blob read/write token. Created automatically when you connect a Blob store to the project.
# Holds the last good snapshot and the encrypted, rotating Skroutz tokens.
BLOB_READ_WRITE_TOKEN=

# Long random string (openssl rand -hex 24). Password for the /admin refresh form AND the key that
# encrypts the Skroutz tokens stored in Blob. Changing it means re-running the Skroutz sign-in.
ADMIN_SECRET=

# Printed once by `node scripts/skroutz-auth.mjs`. Without these the app serves the bundled sample data.
SKROUTZ_CLIENT_ID=
SKROUTZ_CLIENT_SECRET=
SKROUTZ_REFRESH_TOKEN=

# Optional
# SOURCES=skroutz,bestprice          # restrict which sources run
# BESTPRICE_REFRESH_SECONDS=21600    # 6h default; BestPrice's free tier caps unidentified clients per day
